{
  "name": "CIS 774 - GnuCOBOL",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bitlang.cobol"
      ],
      "settings": {
        "files.associations": {
          "*.cob": "BITLANG-COBOL",
          "*.cbl": "BITLANG-COBOL"
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/verify.sh"
}
